{
  "expo": {
    "name": "Mohakash Jr",
    "slug": "mohakash-jr",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mohakashjr",
    "userInterfaceStyle": "dark",
    "icon": "./assets/brand/icon.png",
    "backgroundColor": "#0B1026",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sheikhhossainn.mohakashjr"
    },
    "android": {
      "package": "com.sheikhhossainn.mohakashjr",
      "allowBackup": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#0B1026"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B1026"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a9ab89a8-86ae-4fe5-a706-06f08ff84329"
      }
    },
    "owner": "sheikhhossainns-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a9ab89a8-86ae-4fe5-a706-06f08ff84329"
    }
  }
}
